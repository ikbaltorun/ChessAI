@{
    ViewData["Title"] = "Satranç AI";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Satranç AI</h1>

    <div id="board" style="width: 500px; margin: auto;"></div>
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/chessboard-js/1.0.0/chessboard-1.0.0.min.css">

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chessboard-js/1.0.0/chessboard-1.0.0.min.js"></script>

<script>
    // Satranç oyununun kendisi
    var game = new Chess();

    // Sıra başlangıçta oyuncuda
    var playerTurn = true;

    // Satranç tahtasını oluştur
    var board = Chessboard('board', {
        draggable: true,
        position: 'start',

        // Taşların görselleri
        pieceTheme: 'https://chessboardjs.com/img/chesspieces/wikipedia/{piece}.png',

        // Bir taş bırakıldığında çalışır
        onDrop: function (source, target) {

            // AI düşünüyorsa oyuncu hamle yapamasın
            if (!playerTurn) {
                return 'snapback';
            }

            // Oyuncunun hamlesini chess.js'e gönder
            var move = game.move({
                from: source,
                to: target,
                promotion: 'q'
            });

            // Geçersiz hamleyse taşı geri gönder
            if (move === null) {
                return 'snapback';
            }

            // Oyuncunun hamlesiyle oyun bittiyse
            if (game.game_over()) {
                board.position(game.fen());
                alert("Oyun bitti!");
                return;
            }

            // Artık sıra AI'da
            playerTurn = false;

            console.log("Senin hamlen:", source + target);

            // Güncel tahtanın FEN bilgisi
            var fen = game.fen();

            console.log("FEN:", fen);

            // FEN bilgisini C# Controller'a gönder
            fetch('/Chess/GetAIMove', {
                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify({
                    fen: fen
                })
            })

            // C#'tan gelen cevabı JSON olarak al
            .then(response => response.json())

            .then(data => {

                console.log("Stockfish hamlesi:", data.move);

                // Stockfish'in hamlesini al
                var aiMove = game.move({
                    from: data.move.substring(0, 2),
                    to: data.move.substring(2, 4),
                    promotion: 'q'
                });

                // Tahtayı güncelle
                board.position(game.fen());

                // AI'ın hamlesiyle oyun bittiyse
                if (game.game_over()) {
                    alert("Oyun bitti!");
                    return;
                }

                // AI oynadı, tekrar oyuncunun sırası
                playerTurn = true;
            })

            // Bir hata oluşursa
            .catch(error => {

                console.error("AI hatası:", error);

                // Hata olsa bile sıra tekrar oyuncuya geçsin
                playerTurn = true;
            });
        }
    });
</script>